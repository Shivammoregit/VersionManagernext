# Version Manager Next - Environment Configuration
# Copy this file to .env.local and fill in your values

# =============================================================================
# MongoDB Configuration (existing)
# =============================================================================
MONGODB_URI=mongodb+srv://your-connection-string

# =============================================================================
# Play Store Scraper Configuration
# =============================================================================

# Cache TTL in milliseconds (default: 3600000 = 1 hour)
# Minimum: 60000 (1 minute), Maximum: 86400000 (24 hours)
PLAYSTORE_CACHE_TTL_MS=3600000

# Maximum number of entries in cache (default: 1000)
PLAYSTORE_MAX_CACHE_SIZE=1000

# Rate limit: maximum requests per window (default: 10)
PLAYSTORE_RATE_LIMIT=10

# Rate limit window in milliseconds (default: 60000 = 1 minute)
PLAYSTORE_RATE_LIMIT_WINDOW_MS=60000

# Log level: debug, info, warn, error (default: info)
PLAYSTORE_LOG_LEVEL=info

# Optional API key for protecting endpoints
# If set, requests must include this key via header (PLAYSTORE_API_KEY_HEADER)
# or via query param ?key=... (useful for cron calling /api/sync/playstore).
# Leave empty to allow unauthenticated access
PLAYSTORE_API_KEY=

# Custom header name for API key (default: x-api-key)
PLAYSTORE_API_KEY_HEADER=x-api-key

# Request timeout in milliseconds (default: 30000 = 30 seconds)
PLAYSTORE_REQUEST_TIMEOUT_MS=30000

# Maximum retry attempts for failed requests (default: 3)
PLAYSTORE_MAX_RETRIES=3

# Base delay for exponential backoff in milliseconds (default: 1000 = 1 second)
PLAYSTORE_RETRY_BASE_DELAY_MS=1000

# Enable monitoring hooks (default: false)
PLAYSTORE_ENABLE_MONITORING=false
